# MJOLNIR — Nebius Token Factory / NVIDIA NIM & Tavily Configuration
# Copy this file to .env or configure keys live inside the UI header drawer.
# Accepts either a Nebius Token Factory key OR a free NVIDIA NIM `nvapi-...` key (https://build.nvidia.com).

NEBIUS_API_KEY=your_nebius_token_factory_api_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Tavily Live Web Grounding API Key (/search, /extract, /map)
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# Local Server Port
PORT=8080
